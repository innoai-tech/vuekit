  },
  "scripts": {
    "build": "tsdown",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "oxc-codegen": "^0.148.0",
    "oxc-parser": "^0.148.0"
  },
  "inlinedDependencies": {
    "@oxc-project/types": "0.147.0",
    "@rolldown/pluginutils": "1.0.1",
    "rolldown": "1.2.6"
  }
}
