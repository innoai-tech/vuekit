{
  "name": "@innoai-tech/bundle-purge",
  "version": "0.2.1",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:innoai-tech/vuekit.git",
    "directory": "nodedevpkg/bundle-purge"
  },
  "files": [
    "!/**/__tests__",
    "dist/*",
    "src/*"
  ],
