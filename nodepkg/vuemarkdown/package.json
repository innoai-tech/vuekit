{
  "name": "@innoai-tech/vuemarkdown",
  "version": "0.6.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "ssh://git@github.com:innoai-tech/vuekit.git",
    "directory": "nodepkg/vuemarkdown"
  },
  "files": [
    "!/**/__tests__",
    "dist/*",
    "src/*"
  ],
