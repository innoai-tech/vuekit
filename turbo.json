{
  "$schema": "https://turborepo.org/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/*", "*.config.ts", "package.json"],
      "outputs": ["dist/*", "pkg/*"],
      "passThroughEnv": ["RUSTUP_HOME", "RUSTUP_TOOLCHAIN", "CARGO_HOME", "WASM_PACK_CACHE"]
    }
  }
}
